# Leave empty in local dev. Vite proxies /api to the Worker on http://127.0.0.1:8787.
# On Cloudflare Pages, set this to your deployed Worker origin (no trailing slash),
# for example https://thehaoftravelo-api.<account>.workers.dev
VITE_API_BASE=

# Cloudflare Web Analytics beacon token. Leave empty to disable the snippet.
VITE_CF_BEACON_TOKEN=
